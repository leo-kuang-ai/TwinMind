# spec-first:start
# host-local scratch and settings
.claude/tasks/
.claude/worktrees/
.qoder/settings.local.json

# spec-first local setup and workflow runtime artifacts
.spec-first/*.local.yaml
.spec-first/config.local.yaml
.spec-first/config/*.json
.spec-first/audits/
.spec-first/governance/
.spec-first/app-audit/
.spec-first/workflows/
.spec-first/workspace/
.spec-first/sessions/

# optional provider local artifacts
.codegraph/
graphify-out/
.graphify/
# spec-first:end

# TwinMind bootstrap-second-brain local verification and release outputs
dist/
skills/bootstrap-second-brain/evals/results/
skills/bootstrap-second-brain/**/__pycache__/
skills/bootstrap-second-brain/**/*.pyc
skills/bootstrap-second-brain/**/*.sig
# 宿主生成的运行时镜像（由 spec-first 工具管理，不入库）
.agents/
.codex/
.kiro/

# ai-search-kit 运行时产物（密钥/评测结果/告警日志/缓存，可重建）
ai-search-kit/.env
ai-search-kit/eval/golden_set.json
ai-search-kit/eval/eval-*.md
ai-search-kit/.health_alerts.log
ai-search-kit/**/__pycache__/


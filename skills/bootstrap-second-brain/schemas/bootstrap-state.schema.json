{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","required":["schema_version","run_id","journey","phase","lifecycle_state","run_state","health","command_outcome","state_storage"],"properties":{"schema_version":{"const":1},"run_id":{"type":"string","minLength":3,"maxLength":128},"journey":{"enum":["create","verify","adopt-existing"]},"phase":{"enum":["trigger","tool_prepare","path_confirm","probe","plan","scaffold","discover","personalize","environment","verify","activate","handoff"]},"lifecycle_state":{"enum":["new","planned","scaffolded","personalized","initialized","activated"]},"run_state":{"enum":["active","paused","completed","cancelled","failed"]},"health":{"enum":["healthy","degraded"]},"command_outcome":{"enum":["success","no_changes","action_required","conflict","degraded","unsafe_target","plan_stale","partial","failed"]},"state_storage":{"type":"object","required":["identity_digest","storage_domain","classification_evidence_digest","encryption_status"],"properties":{"identity_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"storage_domain":{"enum":["local_fixed","cloud_synced","network","removable","unknown"]},"classification_evidence_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"encryption_status":{"enum":["unavailable","verified"]},"encryption_receipt_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"}},"additionalProperties":false}},"additionalProperties":false}

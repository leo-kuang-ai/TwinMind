{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "plan_id", "run_id", "plan_digest", "subject_kind", "subject_identity_digest", "generated_at", "operations"],
  "properties": {
    "schema_version": {"const": 1},
    "plan_schema_version": {"const": 1},
    "plan_id": {"type": "string", "minLength": 3},
    "run_id": {"type": "string", "minLength": 3},
    "journey": {"enum": ["create", "verify", "adopt-existing"]},
    "plan_stage": {"enum": ["tool_prepare", "scaffold", "personalize", "environment", "inventory", "recovery", "cleanup"]},
    "plan_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "subject_kind": {"enum": ["vault", "host_tool", "state_cleanup", "recovery"]},
    "subject_identity_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target_identity_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "generated_at": {"type": "string", "minLength": 10},
    "requested_path": {"type": "string", "minLength": 1},
    "normalized_path": {"type": "string", "minLength": 1},
    "probe_snapshot_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "starter_version": {"type": "string", "minLength": 1},
    "starter_source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "starter_source_tree_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "starter_manifest": {"type": "string", "minLength": 1},
    "starter_manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tool_readiness_receipt_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tool_readiness_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "parent_git_detected": {"type": "boolean"},
    "parent_git_boundary_digest": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{64}$"}]},
    "inventory_policy_id": {"const": "personal-vault-v1"},
    "inventory_policy_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "effective_limits": {"type": "object", "additionalProperties": true},
    "state_storage": {"type": "object", "additionalProperties": true},
    "state_binding": {"type": "object", "additionalProperties": true},
    "claim_ceiling": {"type": "string", "minLength": 1},
    "identity_manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tool_id": {"type": "string", "minLength": 1},
    "answers_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "profile_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "git_executable": {"type": "string", "minLength": 1},
    "boundary": {"type": "object", "additionalProperties": true},
    "repository_root": {"type": "string", "minLength": 1},
    "environment_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "approved_files": {"type": "array", "items": {"type": "string"}},
    "approved_git_paths": {"type": "array", "items": {"type": "string"}},
    "expected_staged_files": {"type": "array", "items": {"type": "string"}},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "command_outcome": {"enum": ["planned", "action_required"]},
    "state_root": {"type": "string", "minLength": 1},
    "scope": {"enum": ["interview", "all"]},
    "state_root_identity_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "run_identity_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "recovery_loss_acknowledged": {"type": "boolean"},
    "recovery_mode": {"enum": ["pre_baseline_delete", "post_baseline_compensation", "manual_git_recovery"]},
    "recovery_root_identity_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "requested_target": {"type": "string", "minLength": 1},
    "remove_root_if_empty": {"type": "boolean"},
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["operation_id", "kind"],
        "properties": {
          "operation_id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["copy-starter", "render-profile", "git-init", "git-local-identity", "git-add", "git-baseline-commit", "open-source", "open-app", "recover-file", "compensation-commit", "cleanup-state"]},
          "relative_path": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "ownership": {"enum": ["static", "generated-once", "managed-block", "append-only", "user-owned"]},
          "content_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "value": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
